# One API on one port, one PostgreSQL database.
#   energy_provider  http://localhost:3000/api/v1
#   energy_service   http://localhost:3000/api
#   energy_website   http://localhost:3000/api/website
#   superadmin       http://localhost:3000/api/superadmin

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5332
DB_NAME=GravityHub_App
DB_USER=postgres
DB_PASSWORD="Zypli@abc"
DB_SSL=false
DATABASE_URL=postgresql://postgres:Zypli@abc@localhost:5332/GravityHub_App

JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
OTP_TTL_MS=600000
CORS_ORIGIN=*
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
SMS_PROVIDER=dev
ENABLE_DEV_MAILBOX=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
TRUST_PROXY=false

# Superadmin console login (use a unique password of at least 12 characters).
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=
SUPERADMIN_DATA_FILE=./data/superadmin-access-control.json

# Optional login card for local development only. Never enable outside development.
ENABLE_LOCAL_DEMO_LOGIN=false
LOCAL_DEMO_EMAIL=Superadmin@gmail.com
LOCAL_DEMO_PASSWORD=
